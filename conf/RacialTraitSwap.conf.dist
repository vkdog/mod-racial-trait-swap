[worldserver]

###################################################################################################
#Azerothcore Racial Trait Swap NPC  #
#####################################
#
#    Azerothcore Racial Trait NPC Cost
#        For a cost, you can swap our you current racial traits for that of another.
#
#    Azerothcore.Racial.Trait.Swap.Announce.enable
#         Description: Announces Module when player logs in.
#         Default:    0 - (Disabled)
#                     1 - (Enabled)

Azerothcore.Racial.Trait.Swap.Announce.enable = 1

#
#    Racial.Traits.Swap.Gold
#         Description:  Cost in gold for Racial Trait Exchange.
#         Default:    0 - (Zero Gold Free)
#                     10 - (Ten Gold Cost)

Racial.Traits.Swap.Gold = 10

#
#    Racial.Traits.Swap.Class.Restriction
#         Description: Restricts available race options to races that share the player's class.
#                      Example: A Paladin can only choose Human, Dwarf, Draenei, or Blood Elf traits.
#         Default:    0 - (Disabled - all races always available)
#                     1 - (Enabled)

Racial.Traits.Swap.Class.Restriction = 1

#
###################################################################################################
